{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dest",
    "tsBuildInfoFile": ".tsbuildinfo",
    "target": "es2020",
    "lib": ["esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "declarationMap": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*", "test/**/*"]
}
