{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@privpnl/proof": ["../../packages/proof/src/index.ts"],
      "@privpnl/proof/*": ["../../packages/proof/src/*"],
      "@privpnl/contracts": ["../../packages/contracts/src/index.ts"],
      "@privpnl/contracts/*": ["../../packages/contracts/src/*"],
      "@privpnl/circuits": ["../../packages/circuits/ts/artifacts.ts"],
      "@privpnl/circuits/*": ["../../packages/circuits/ts/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
